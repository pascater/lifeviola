          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "@min-height": "90px",
            "@min-height-small": "(@min-height / 2)",
            "overflow": "hidden",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-head": {
              "max-width": "800px"
            },
            ".loop-container": {
              ".item": {
                "min-height": "auto"
              }
            },
            ".item": {
              "color": "@contentColor",
              "min-height": "@min-height",
              "@media (max-width: 768px)": {
                "min-height": "@min-height-small"
              }
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gellery01 servicem5\" group=\"Gallery & Slider\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"2\">\n        <header>Animated Text Settings</header>\n        <select title=\"Font style\" name=\"linesTitle\">\n            <option value=\"title1\">Title 1</option>\n            <option value=\"title2\">Title 2</option>\n            <option value=\"title3\" selected>Title 3</option>\n        </select>\n        <input type=\"text\" title=\"Line content 1 <br> (For the best experience, please write at least 100 characters)\" inline name=\"animatedLine1\" value=\"Preventivo immediato e personalizzato * Sottoscrizione semplice e veloce * \">\n        <input type=\"range\" inline title=\"Line speed\" name=\"speed\" min=\"0.01\" max=\"0.09\" step=\"0.01\" value=\"0.03\">\n        <select title=\"Direction\" name=\"direction\">\n            <option value=\"-1\" selected>Left</option>\n            <option value=\"1\">Right</option>\n        </select>\n        <input type=\"color\" title=\"Content Color\" value=\"#000000\" name=\"contentColor\" selected>\n<!--        <input type=\"color\" title=\"Content BG\" value=\"#050f0f\" name=\"container\" selected>-->\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#E0AAFF\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffd9c8\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container-fluid\">\n        <div class=\"loop-container\">\n            <div class=\"item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2', 'display-5':linesTitle=='title3'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">\n                WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n            </div>\n            <div class=\"item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2', 'display-5':linesTitle=='title3'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">\n                WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n                · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS · WEB HOSTING BUSINESS\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "gallery01",
          "_sourceTheme": "servicem5",
          "_cid": "uvNUp9t3Nz",
          "_anchor": "features-9-uvNUp9t3Nz",
          "alias": false,
          "_protectedParams": [],
          "_global": false,
