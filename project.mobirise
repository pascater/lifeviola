          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "32px",
              "padding": "80px 60px",
              "overflow": "hidden",
              "@media (max-width: 1200px)": {
                "gap": "16px"
              },
              "@media (max-width: 1199px)": {
                "grid-template-columns": "1fr 1fr"
              },
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "32px 16px"
              },
              "& when (@showImage)": {
                "border": "2px solid @borderImage"
              },
              ".image-wrapper": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "opacity": "@imageOpacity",
                  "animation": "none"
                }
              },
              ".item": {
                "@media (max-width: 992px)": {
                  "margin-bottom": "16px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                ".item-wrapper": {
                  "position": "relative",
                  "height": "100%",
                  "border": "3px solid @border",
                  "box-shadow": "4px 4px 0 0 @border",
                  "transition": "all 0.3s ease-in-out",
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "overflow": "hidden",
                  "background-color": "@card",
                  "&:hover, &:focus": {
                    "transform": "translate(0.2rem, 0.2rem)",
                    "box-shadow": "none"
                  },
                  ".item-content": {
                    ".item-img": {
                      "border-bottom": "3px solid @border",
                      "img": {
                        "height": "390px",
                        "width": "100%",
                        "object-fit": "cover",
                        "border-radius": "0 !important",
                        "@media (max-width: 992px)": {
                          "height": "350px"
                        }
                      },
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "top": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "100%",
                        "pointer-events": "none",
                        "opacity": "0.8"
                      }
                    },
                    ".text-wrapper": {
                      "padding": "32px",
                      "@media (max-width: 1440px)": {
                        "padding": "32px 24px"
                      },
                      "@media (max-width: 992px)": {
                        "padding": "32px 16px"
                      },
                      ".item-title": {
                        "margin-bottom": "48px",
                        "@media (max-width: 992px)": {
                          "margin-bottom": "24px"
                        }
                      },
                      ".item-text": {
                        "margin-bottom": "16px",
                        "@media (max-width: 992px)": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  },
                  ".tags-wrapper": {
                    "padding": "0 32px 24px 32px",
                    "@media (max-width: 1440px)": {
                      "padding": "0 24px 24px 24px"
                    },
                    "@media (max-width: 992px)": {
                      "padding": "0 16px 24px 16px"
                    },
                    ".list": {
                      "display": "inline-flex",
                      "flex-wrap": "wrap",
                      "margin": "0",
                      "padding": "0",
                      "list-style-type": "none",
                      ".item-wrap": {
                        "display": "inline-flex",
                        "padding": "11px 20px",
                        "margin": "0 8px 8px 0",
                        "background-color": "@tag_1",
                        "&:nth-child(2n)": {
                          "background-color": "@tag_2"
                        },
                        "&:nth-child(3n)": {
                          "background-color": "@tag_3"
                        }
                      }
                    }
                  }
                }
              }
            },
            ".item-title": {
              "color": "#000000"
            },
            ".item-text": {
              "color": "#000000"
            },
            ".list": {
              "color": "#050f0f"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 servicem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Image BG\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Image Border Color\" value=\"#7B2CBF\" name=\"borderImage\" condition=\"showImage\" selected>\n        <input type=\"range\" inline title=\"Image BG Opacity\" name=\"imageOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"showImage\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Tags\" name=\"showTags\">\n        <input type=\"color\" title=\"Tags BG 1\" value=\"#d3f2ff\" name=\"tag_1\" condition=\"showTags\" selected>\n        <input type=\"color\" title=\"Tags BG 2\" value=\"#bafca2\" name=\"tag_2\" condition=\"showTags\" selected>\n        <input type=\"color\" title=\"Tags BG 3\" value=\"#fdfd96\" name=\"tag_3\" condition=\"showTags\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#000000\" name=\"border\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#FCF7FF\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                        <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1724304406928-c43b01912fa1.jpeg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1713021947821-ac3dde7b191f.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Testimonianze Reali</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Scopri le storie di chi ci ha scelto!</p>\n                                </div>\n                            </div>\n                            <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tags-wrapper\" data-multiline=\"\" mbr-article=\"\">\n                                    <li class=\"item-wrap\">DATABASE</li>\n                                    <li class=\"item-wrap\">TESTING</li>\n                                    <li class=\"item-wrap\">SCALING</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1585816805178-a30724f9d4ca.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Casi Studio</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Analizziamo successi concreti!</p>\n                                </div>\n                            </div>\n                            <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tags-wrapper\" data-multiline=\"\" mbr-article=\"\">\n                                    <li class=\"item-wrap\">DATABASE</li>\n                                    <li class=\"item-wrap\">TESTING</li>\n                                    <li class=\"item-wrap\">SCALING</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-content\">\n                                <div class=\"item-img\">\n                                    <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1590935216595-f9fc9b65179d.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Sicurezza Finanziaria</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">La nostra stabilità è la tua garanzia!</p>\n                                </div>\n                            </div>\n                            <div class=\"tags-wrapper\" mbr-if=\"showTags\">\n                                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap, .tags-wrapper\" data-multiline=\"\" mbr-article=\"\">\n                                    <li class=\"item-wrap\">DATABASE</li>\n                                    <li class=\"item-wrap\">TESTING</li>\n                                    <li class=\"item-wrap\">SCALING</li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "features03",
          "_sourceTheme": "servicem5",
          "_cid": "uvNUp9DaC8",
          "_anchor": "features-3-uvNUp9DaC8",
          "alias": false,
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".mbr-section-title": {
              "padding": "0 60px",
              "margin-bottom": "80px",
              "@media (max-width: 992px)": {
                "padding": "0",
                "margin-bottom": "24px"
              },
              "color": "#000000"
            },
            ".embla__slide": {
              "display": "flex",
              "justify-content": "center",
              "position": "relative",
              "min-width": "512px",
              "max-width": "512px",
              "@media (max-width: 767px)": {
                "min-width": "100%",
                "max-width": "100%"
              },
              ".slide-content": {
                "width": "100%",
                ".item-wrapper": {
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "height": "100%",
                  "background-color": "@card",
                  "border": "3px solid @border",
                  "overflow": "hidden"
                },
                ".item-content": {
                  ".item-img": {
                    "img": {
                      "height": "300px",
                      "width": "100%",
                      "object-fit": "cover",
                      "border-bottom": "3px solid @border",
                      "border-radius": "0 !important"
                    }
                  },
                  ".text-wrapper": {
                    "position": "relative",
                    "z-index": "1",
                    "padding": "32px",
                    "@media (max-width: 992px)": {
                      "padding": "32px 16px 24px 16px"
                    },
                    ".item-date": {
                      "margin-bottom": "8px",
                      "opacity": "0.7"
                    },
                    ".item-title": {
                      "margin-bottom": "24px"
                    },
                    ".item-text": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".icon-wrapper": {
                  "position": "relative",
                  "z-index": "1",
                  "padding": "0 32px 32px 32px",
                  "@media (max-width: 992px)": {
                    "padding": "0 16px 32px 16px"
                  },
                  ".mbr-iconfont": {
                    "width": "56px",
                    "height": "56px",
                    "font-size": "24px",
                    "display": "inline-flex",
                    "align-items": "center",
                    "justify-content": "center",
                    "color": "@icon",
                    "background-color": "@iconBg",
                    "border": "3px solid @icon",
                    "border-radius": "100%",
                    "box-shadow": "2px 2px @icon",
                    "transition": "all 0.3s ease-in-out",
                    "&:hover, &:focus": {
                      "box-shadow": "none",
                      "transform": "translate(1px, 1px)"
                    }
                  }
                }
              }
            },
            ".embla__button--next, .embla__button--prev": {
              "display": "flex"
            },
            ".embla__button": {
              "bottom": "0",
              "width": "56px",
              "height": "56px",
              "font-size": "24px",
              "background-color": "@arrowsBg !important",
              "color": "@arrowsColor !important",
              "border": "3px solid @arrowsColor !important",
              "box-shadow": "2px 2px @arrowsColor",
              "border-radius": "50%",
              "transition": "all 0.3s",
              "position": "absolute",
              "display": "flex",
              "justify-content": "center",
              "align-items": "center",
              "opacity": "1 !important",
              "& when not (@arrows)": {
                "display": "none"
              },
              "& when not (@arrowsMobile)": {
                "@media (max-width: 768px)": {
                  "display": "none"
                }
              },
              "&:hover": {
                "box-shadow": "none",
                "transform": "translate(1px, 1px)"
              },
              "&.embla__button--prev": {
                "left": "60px",
                "@media (max-width: 992px)": {
                  "left": "0"
                }
              },
              "&.embla__button--next": {
                "right": "60px",
                "@media (max-width: 992px)": {
                  "right": "0"
                }
              }
            },
            ".embla": {
              "position": "relative",
              "width": "100%",
              "padding": "0 60px",
              "@media (max-width: 992px)": {
                "padding": "0"
              },
              "& when (@arrows)": {
                "padding": "0 60px 6rem 60px",
                "@media (max-width: 992px)": {
                  "padding": "0 0 6rem 0"
                }
              }
            },
            ".embla__viewport": {
              "overflow": "hidden",
              "width": "100%",
              "margin-right": "1rem"
            },
            ".embla__viewport.is-draggable": {
              "cursor": "grab"
            },
            ".embla__viewport.is-dragging": {
              "cursor": "grabbing"
            },
            ".embla__container": {
              "display": "flex",
              "user-select": "none",
              "-webkit-touch-callout": "none",
              "-khtml-user-select": "none",
              "-webkit-tap-highlight-color": "transparent"
            },
            ".item-menu-overlay": {
              "opacity": "0 !important"
            },
            ".item-date": {
              "color": "#FFFFFF"
            },
            ".item-title": {
              "color": "#050f0f"
            },
            ".item-text": {
              "color": "#FFFFFF"
            },
            ".icon-wrapper": {
              "text-align": "right"
            },
            ".item-title, .icon-wrapper": {
              "color": "#FFFFFF"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"slider01 mbr-embla servicem5\" group=\"Sliders & Galleries\" plugins=\"embla\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showTitle\" title=\"Title\" checked>\n        <header>Carousel</header>\n        <input type=\"checkbox\" title=\"Autoplay\" name=\"autoplay\">\n        <input type=\"range\" title=\"Interval\" name=\"interval\" min=\"1\" max=\"10\" value=\"5\" step=\"1\" condition=\"autoplay\">\n        <input type=\"checkbox\" title=\"Loop\" name=\"loop\" checked>\n        <input type=\"checkbox\" title=\"Draggable\" name=\"draggable\" checked>\n        <input type=\"checkbox\" name=\"arrows\" title=\"Arrows\" checked>\n        <input type=\"checkbox\" name=\"arrowsMobile\" title=\"Mobile Arrows\" condition=\"arrows\" checked>\n        <input type=\"color\" title=\"Arrows Color\" value=\"#000000\" name=\"arrowsColor\" condition=\"arrows\" selected>\n        <input type=\"color\" title=\"Arrows BG\" value=\"#FCF7FF\" name=\"arrowsBg\" condition=\"arrows\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\">\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"autoSize && !(showButtons==false && showCardSubtitle==false && showCardTitle==false && showText==false)\">\n        <input type=\"range\" name=\"gap\" title=\"Gap\" min=\"0\" max=\"2\" step=\"0.25\" value=\"1.75\">\n        <input type=\"checkbox\" name=\"showDate\" title=\"Card Date\" checked>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Card Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#FCF7FF\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"color\" name=\"border\" title=\"Card Border\" value=\"#000000\">\n        <input type=\"color\" name=\"card\" title=\"BG\" value=\"#3C096C\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax required>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h4 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Ultime Novità</h4>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <div class=\"embla\" data-loop=\"{{loop}}\" data-auto-play=\"{{autoplay}}\" data-auto-play-interval=\"{{interval}}\" data-draggable=\"{{draggable}}\" data-skip-snaps=\"true\" data-align=\"center\" data-contain-scroll=\"trimSnaps\">\n                    <div class=\"embla__viewport\">\n                        <div class=\"embla__container\">\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-content\">\n                                            <div class=\"item-img\">\n                                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1581289064309-da58a92766ff.jpeg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <div class=\"text-wrapper\">\n                                                <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-7\" data-app-selector=\".item-date\">2024-11-15</p>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Assicurazione Facile</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Scopri come ottenere un&#x27;assicurazione sulla vita in pochi clic e senza stress!</p>\n                                            </div>\n                                        </div>\n                                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                            <a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span></a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-content\">\n                                            <div class=\"item-img\">\n                                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1593786950854-8da7046c5690.jpeg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <div class=\"text-wrapper\">\n                                                <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-7\" data-app-selector=\".item-date\">2024-11-01</p>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Proteggi i Tuoi Cari</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Ecco perché la protezione della tua famiglia è fondamentale. Non lasciare nulla al caso!</p>\n                                            </div>\n                                        </div>\n                                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                            <a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span></a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-content\">\n                                            <div class=\"item-img\">\n                                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1582571008093-fc9b41800be5.jpeg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <div class=\"text-wrapper\">\n                                                <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-7\" data-app-selector=\".item-date\">2024-10-20</p>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Pianificazione Futura</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Inizia a pianificare il tuo futuro oggi stesso. Non aspettare che sia troppo tardi!</p>\n                                            </div>\n                                        </div>\n                                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                            <a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span></a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-content\">\n                                            <div class=\"item-img\">\n                                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1496745109441-36ea45fed379.jpeg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <div class=\"text-wrapper\">\n                                                <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-7\" data-app-selector=\".item-date\">2024-10-05</p>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Vantaggi Assicurativi</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Scopri i vantaggi unici dell&#x27;assicurazione sulla vita e come possono aiutarti!</p>\n                                            </div>\n                                        </div>\n                                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                            <a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span></a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-content\">\n                                            <div class=\"item-img\">\n                                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1575468332949-4bd46064dd66.jpeg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <div class=\"text-wrapper\">\n                                                <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-7\" data-app-selector=\".item-date\">2024-09-15</p>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Testimonianze Clienti</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Leggi le storie di chi ha scelto LifeInsure e come abbiamo cambiato le loro vite!</p>\n                                            </div>\n                                        </div>\n                                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                            <a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span></a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"embla__slide slider-image item\" mbr-style=\"{'margin-left': gap + 'rem', 'margin-right': gap + 'rem'}\">\n                                <div class=\"slide-content\">\n                                    <div class=\"item-wrapper\">\n                                        <div class=\"item-content\">\n                                            <div class=\"item-img\">\n                                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1580585245284-8354f4aeac2d.jpeg\" alt=\"Mobirise Website Builder\">\n                                            </div>\n                                            <div class=\"text-wrapper\">\n                                                <p class=\"item-date mbr-fonts-style\" mbr-if=\"showDate\" mbr-theme-style=\"display-7\" data-app-selector=\".item-date\">2024-09-01</p>\n                                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Sicurezza Prima</h4>\n                                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">La sicurezza finanziaria è la chiave per una vita serena. Scopri come possiamo aiutarti!</p>\n                                            </div>\n                                        </div>\n                                        <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                            <a href=\"#\"><span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span></a>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <button class=\"embla__button embla__button--prev\">\n                        <span class=\"mbr-iconfont mobi-mbri-left mobi-mbri\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Previous</span>\n                    </button>\n                    <button class=\"embla__button embla__button--next\">\n                        <span class=\"mbr-iconfont mobi-mbri-right mobi-mbri\" aria-hidden=\"true\"></span>\n                        <span class=\"sr-only visually-hidden visually-hidden visually-hidden\">Next</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "slider01",
          "_sourceTheme": "servicem5",
          "_cid": "uvNUp9EF0P",
          "_anchor": "blog-1-uvNUp9EF0P",
          "alias": false,
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "position": "relative",
              "padding": "80px 60px",
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "32px 16px"
              },
              "& when (@showImage)": {
                "border": "2px solid @borderImage"
              },
              ".image-wrapper": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "opacity": "@imageOpacity",
                  "animation": "none"
                }
              },
              ".mbr-section-title": {
                "position": "relative",
                "z-index": "1",
                "margin-bottom": "80px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "24px"
                }
              },
              ".card-wrapper": {
                "position": "relative",
                "z-index": "1",
                "width": "75%",
                "border": "3px solid @border",
                "box-shadow": "4px 4px 0 0 @border",
                "background-color": "@border",
                "-webkit-flex": "inherit",
                "@media (max-width: 992px)": {
                  "width": "100%"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#050f0f",
              "text-align": "center"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"video01 servicem5\" group=\"Image & Video\" plugins=\"PlayerVimeo\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Image BG\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Image Border Color\" value=\"#7B2CBF\" name=\"borderImage\" condition=\"showImage\" selected>\n        <input type=\"range\" inline title=\"Image BG Opacity\" name=\"imageOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"showImage\">\n        <header>Video</header>\n        <input type=\"color\" title=\"Video Border\" value=\"#000000\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                        <b>View on Action</b>\n                    </h2>\n                    <div class=\"card-wrapper\">\n                        <div mbr-video=\"\" class=\"mbr-figure\">\n                            <iframe src=\"https://www.youtube.com/embed/lbf11PXh4bU?autoplay&#x3D;1&amp;loop&#x3D;1&amp;playlist&#x3D;lbf11PXh4bU&amp;t&#x3D;20&amp;mute&#x3D;1&amp;playsinline&#x3D;1&amp;controls&#x3D;0&amp;showinfo&#x3D;0&amp;autohide&#x3D;1&amp;allowfullscreen&#x3D;true&amp;mode&#x3D;transparent\"></iframe>\n                        </div>\n                    </div>\n                    <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                        <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1714168760392-ad3a38e15cac.jpeg\" alt=\"Mobirise\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
