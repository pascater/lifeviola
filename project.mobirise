                "width": "45%",
                "@media (max-width: 992px)": {
                  "width": "100%"
                },
                "img": {
                  "height": "580px",
                  "width": "100%",
                  "object-fit": "cover",
                  "@media (max-width: 992px)": {
                    "height": "350px"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#050f0f"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-section-btn": {
              "text-align": "center"
            },
            ".icon-wrapper": {
              "text-align": "right"
