        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".items-wrapper": {
              "display": "grid",
              "grid-template-columns": "1fr 1fr 1fr",
              "gap": "32px",
              "padding": "0 60px",
              "@media (max-width: 992px)": {
                "display": "block",
                "padding": "0"
              },
              ".item": {
                "@media (max-width: 992px)": {
                  "margin-bottom": "16px"
                },
                ".item-wrapper": {
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "height": "100%",
                  "background-color": "@card",
                  "border": "3px solid @border",
                  "overflow": "hidden"
                },
                ".item-img": {
                  "img": {
                    "height": "400px",
                    "width": "100%",
                    "object-fit": "cover",
                    "border-bottom": "3px solid @border",
                    "border-radius": "0 !important",
                    "@media (max-width: 992px)": {
                      "height": "350px"
                    }
                  }
                },
                ".text-wrapper": {
                  "position": "relative",
                  "z-index": "1",
                  "padding": "32px",
                  "@media (max-width: 992px)": {
                    "padding": "32px 16px 24px 16px"
                  },
                  ".item-price": {
                    "margin-bottom": "8px",
                    "opacity": "0.6"
                  },
                  ".item-title": {
                    "margin-bottom": "24px"
                  },
                  ".item-text": {
                    "margin-bottom": "22px"
                  }
                }
              }
            },
            ".item-price": {
              "color": "#000000"
            },
            ".item-title": {
              "color": "#050f0f"
            },
            ".item-text": {
              "color": "#000000"
            },
            ".item-title, .icon-wrapper": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"pricing01 servicem5\" group=\"Pricing\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked=\"\">\n        <input type=\"range\" inline=\"\" title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline=\"\" title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked=\"\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked=\"\">\n        <input type=\"color\" name=\"border\" title=\"Card Border\" value=\"#050f0f\">\n        <input type=\"color\" title=\"Card BG\" value=\"#E0AAFF\" name=\"card\" selected=\"\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax=\"\">\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\" selected=\"\">\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked=\"\">\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n        <input type=\"range\" inline=\"\" title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay &amp;&amp; bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay &amp;&amp; bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"items-wrapper\">\n                    <div class=\"item features-image active\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1618371731836-2b9bff9ac72a.jpeg\" alt=\"Mobirise Website Builder\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\">€10/mese</p>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Polizza Base</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Protezione essenziale per la tua famiglia in caso di imprevisti.</p>\n                                <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                    <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Scopri di Più</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1590935217281-8f102120d683.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"1\" data-bs-slide-to=\"1\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\">€30/mese</p>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Polizza Premium</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">La massima protezione per chi desidera il meglio per i propri cari.</p>\n                                <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                    <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Scopri di Più</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div><div class=\"item features-image\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1551265358-a5f7aa4a226c.jpeg\" alt=\"Mobirise Website Builder\" data-slide-to=\"2\" data-bs-slide-to=\"2\">\n                            </div>\n                            <div class=\"text-wrapper\">\n                                <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-price\">€20/mese</p>\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Polizza Avanzata</h4>\n                                <p class=\"item-text mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Copertura completa con vantaggi extra per la tua serenità.</p>\n                                <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                    <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Scopri di Più</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
