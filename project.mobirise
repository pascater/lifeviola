          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs01 tabs servicem5\" group=\"List\" plugins=\"mbr-tabs\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#E0AAFF\" name=\"container\" selected>\n        <header>Tabs</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n            <option value=\"6\">6</option>\n            </select>\n            <input type=\"color\" title=\"Tabs Color\" value=\"#000000\" name=\"tabs\" selected>\n            <input type=\"color\" title=\"Tabs BG\" value=\"#FCF7FF\" name=\"tabsBg\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .tabs-wrapper\" mbr-if=\"showTitle\">Vantaggi di LifeInsure</h2>\n                        <div class=\"tabs-wrapper\">\n                            <ul class=\"nav nav-tabs\" role=\"tablist\">\n                                <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link show mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-8-uvNUp9RLmt_tab0\" aria-selected=\"false\">Sicurezza</a></li>\n                                <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-8-uvNUp9RLmt_tab1\" aria-selected=\"false\">Flessibilità</a></li>\n                                <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-8-uvNUp9RLmt_tab2\" aria-selected=\"true\">Semplicità</a></li>\n                                <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-8-uvNUp9RLmt_tab3\" aria-selected=\"true\">Affidabilità</a></li>\n                                <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#features-8-uvNUp9RLmt_tab4\" aria-selected=\"false\">Testimonianze</a></li>\n                                <li mbr-buttons mbr-theme-style=\"display-4\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 5\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                                    <a class=\"nav-link show active mbr-fonts-style\" data-app-placeholder=\"Type Text\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab6\" aria-selected=\"true\">\n                                        Reseller\n                                    </a>\n                                </li>\n                            </ul>\n                        </div>\n                    </div>\n                    <div class=\"tab-content\">\n                        <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                            <div class=\"content-wrap\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">Sicurezza</h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Con LifeInsure, la tua famiglia è al sicuro. Le nostre polizze vita garantiscono protezione in caso di imprevisti. Non lasciare nulla al caso, scegli la sicurezza!</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                            <div class=\"content-wrap\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">Flessibilità</h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Personalizza la tua polizza in base alle tue esigenze. Che tu sia un avventuriero o un pianificatore, abbiamo la soluzione giusta per te. Flessibilità totale per ogni stile di vita!</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                            <div class=\"content-wrap\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">Semplicità</h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Sottoscrivere una polizza non è mai stato così semplice. Con un'interfaccia intuitiva e un linguaggio chiaro, il tuo preventivo è a portata di clic. Facile come bere un bicchier d'acqua!</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                            <div class=\"content-wrap\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">Affidabilità</h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">La nostra stabilità finanziaria è la tua garanzia. Con anni di esperienza nel settore, siamo qui per rimanere. I pagamenti in caso di sinistro sono assicurati, senza sorprese!</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                            <div class=\"content-wrap\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">Testimonianze</h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Leggi le storie di chi ha scelto LifeInsure. I nostri clienti soddisfatti parlano chiaro: sicurezza, tranquillità e un futuro sereno. Non fidarti solo di noi, ascolta chi ci ha già scelto!</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div id=\"tab6\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 5\">\n                            <div class=\"content-wrap\">\n                                <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\" data-app-selector=\".item-title\">\n                                    <b>Reseller Hosting</b>\n                                </h4>\n                                <div class=\"text-wrap\" mbr-if=\"showText\">\n                                    <p class=\"item-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">\n                                        Reseller hosting allows individuals or companies to purchase hosting\n                                        resources from a web hosting provider and then resell them to their own\n                                        clients. This type of hosting is ideal for web developers and designers.\n                                        <br><br>\n                                        Web developers, designers, entrepreneurs, and small businesses that want to\n                                        offer hosting services to their clients without managing their own server\n                                        infrastructure.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "tabs01",
