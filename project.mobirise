        },
        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "padding": "80px 90px",
              "background-color": "@container",
              "@media (max-width: 992px)": {
                "padding": "32px 16px"
              },
              ".title-wrapper": {
                "margin-bottom": "80px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "24px"
                },
                ".mbr-section-title": {
                  "margin-bottom": "32px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "24px"
                  }
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "width": "75%",
                    "display": "inline-block",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              },
              ".items-wrapper": {
                "display": "grid",
                "grid-template-columns": "1fr 1fr 1fr",
                "gap": "32px",
                "@media (max-width: 1200px)": {
                  "gap": "16px"
                },
                "@media (max-width: 1199px)": {
                  "grid-template-columns": "1fr 1fr"
                },
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".item": {
                  "@media (max-width: 992px)": {
                    "margin-bottom": "16px",
                    "&:last-child": {
                      "margin-bottom": "0"
                    }
                  },
                  ".item-wrapper": {
                    "position": "relative",
                    "border": "3px solid @border",
                    "display": "flex",
                    "flex-direction": "column",
                    "justify-content": "space-between",
                    "overflow": "hidden",
                    "box-shadow": "4px 4px 0 0 @border",
                    "transition": "all 0.3s ease-in-out",
                    "height": "100%",
                    "&:hover, &:focus": {
                      "transform": "translate(0.2rem, 0.2rem)",
                      "box-shadow": "none",
                      "&::after": {
                        "opacity": "0.5"
                      }
                    },
                    "&::after": {
                      "content": "''",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "pointer-events": "none",
                      "opacity": "0",
                      "background-color": "@border",
                      "transition": "all 0.3s ease-in-out",
                      "z-index": "1"
                    },
                    ".item-img": {
                      "position": "relative",
                      "img": {
                        "height": "400px",
                        "width": "100%",
                        "object-fit": "cover",
                        "border-radius": "0 !important",
                        "@media (max-width: 992px)": {
                          "height": "350px"
                        }
                      },
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "top": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "100%",
                        "pointer-events": "none",
                        "opacity": "0.8"
                      }
                    },
                    ".item-content": {
                      "position": "relative",
                      "z-index": "2",
                      "padding": "32px",
                      "@media (max-width: 1440px)": {
                        "padding": "32px 24px"
                      },
                      "@media (max-width: 992px)": {
                        "padding": "32px 16px"
                      },
                      ".item-title_1, .item-title_2, .item-title_3": {
                        "margin-bottom": "32px",
                        "@media (max-width: 992px)": {
                          "margin-bottom": "24px"
                        }
                      },
                      ".item-text_1, .item-text_2, .item-text_3": {
                        "margin-bottom": "0"
                      },
                      ".mbr-section-btn": {
                        "margin-top": "24px",
                        "@media (max-width: 992px)": {
                          "margin-bottom": "16px"
                        }
                      }
                    }
                  },
                  ".card_1": {
                    "background-color": "@card_1",
                    ".item-img::before": {
                      "background-color": "@card_1"
                    }
                  },
                  ".card_2": {
                    "background-color": "@card_2",
                    ".item-img::before": {
                      "background-color": "@card_2"
                    }
                  },
                  ".card_3": {
                    "background-color": "@card_3",
                    ".item-img::before": {
                      "background-color": "@card_3"
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#000000",
              "text-align": "center"
            },
            ".item-title_1, .mbr-section-btn": {
              "color": "#000000"
            },
            ".item-text_1": {
              "color": "#000000"
            },
            ".item-title_2, .mbr-section-btn": {
              "color": "#FFFFFF"
            },
            ".item-text_2": {
              "color": "#FFFFFF"
            },
            ".item-title_3, .mbr-section-btn": {
              "color": "#FFFFFF"
            },
            ".item-text_3": {
              "color": "#FFFFFF"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features05 servicem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#ECDBEF\" name=\"container\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"Card Border\" value=\"#000000\" name=\"border\" selected>\n        <input type=\"color\" title=\"Card BG 1\" value=\"#E0AAFF\" name=\"card_1\" selected>\n        <input type=\"color\" title=\"Card BG 2\" value=\"#3C096C\" name=\"card_2\" selected>\n        <input type=\"color\" title=\"Card BG 3\" value=\"#7B2CBF\" name=\"card_3\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"title-wrapper\" mbr-if=\"showTitle || showText\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title\" mbr-if=\"showTitle\">Perché Scegliere Noi?</h2>\n                        <div class=\"text-wrapper\" mbr-if=\"showText\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .text-wrapper\">La vita è piena di sorprese, ma la tua assicurazione non dovrebbe esserlo. Con LifeInsure, ottieni una protezione su misura per le tue esigenze. Scopri i vantaggi unici delle nostre polizze vita e come possono fare la differenza per te e la tua famiglia.</p>\n                        </div>\n                    </div>\n                    <div class=\"items-wrapper\">\n                        <div class=\"item features-image\">\n                            <div class=\"item-wrapper card_1\">\n                                <div class=\"item-img\">\n                                    <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1585850417478-cf203b4ac9b1.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"item-content\">\n                                    <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_1, .mbr-section-btn\" mbr-if=\"showCardTitle\">Protezione Familiare</h4>\n                                    <p class=\"item-text_1 mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\">Assicura il benessere dei tuoi cari anche dopo di te.</p>\n                                    <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                        <a class=\"btn btn-secondary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                            Get started!\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-image\">\n                            <div class=\"item-wrapper card_2\">\n                                <div class=\"item-img\">\n                                    <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1507178133921-e5c01f5954ef.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"item-content\">\n                                    <h4 class=\"item-title_2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_2, .mbr-section-btn\" mbr-if=\"showCardTitle\">Pianificazione Successoria</h4>\n                                    <p class=\"item-text_2 mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_2\">Organizza il tuo patrimonio per un futuro sereno.</p>\n                                    <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                        <a class=\"btn btn-warning\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                            Get started!\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-image\">\n                            <div class=\"item-wrapper card_3\">\n                                <div class=\"item-img\">\n                                    <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1602604890877-a60c9b45fd6d.jpeg\" alt=\"Mobirise\">\n                                </div>\n                                <div class=\"item-content\">\n                                    <h4 class=\"item-title_3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_3, .mbr-section-btn\" mbr-if=\"showCardTitle\">Stabilità Finanziaria</h4>\n                                    <p class=\"item-text_3 mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_3\">Siamo solidi come una roccia, sempre pronti a supportarti.</p>\n                                    <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                        <a class=\"btn btn-success\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                            Get started!\n                                        </a>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
