          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features04 servicem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Color\" value=\"#B5838D\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#E0AAFF\" name=\"container\" selected>\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Number\" name=\"showNumber\" checked>\n        <input type=\"color\" title=\"Number Border Color\" value=\"#000000\" name=\"borderNumber\" condition=\"showIcon\" selected>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"color\" title=\"Card Border\" value=\"#000000\" name=\"border\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#FCF7FF\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"content-wrap\">\n                        <div class=\"text-wrapper\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .icon-wrapper\" mbr-if=\"showTitle\">I Nostri Vantaggi</h2>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Scopri perché LifeInsure è la scelta migliore per la tua assicurazione sulla vita. Offriamo vantaggi unici che ti faranno sentire al sicuro e protetto!</p>\n                            <div class=\"icon-wrapper\" mbr-if=\"showIcon\">\n                                <span mbr-icon=\"\" class=\"mbr-iconfont mobi-mbri-globe-2 mobi-mbri\"></span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"items-wrapper\">\n                        <div class=\"item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <p class=\"item-number mbr-fonts-style\" mbr-if=\"showNumber\" mbr-theme-style=\"display-2\" data-app-selector=\".item-number\">\n                                        <b>01</b>\n                                    </p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title, .icon-wrapper\" mbr-if=\"showCardTitle\">Assistenza Dedicata</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Il nostro team è sempre pronto ad aiutarti, 24 ore su 24, 7 giorni su 7. Non sei mai solo!</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <p class=\"item-number mbr-fonts-style\" mbr-if=\"showNumber\" mbr-theme-style=\"display-2\" data-app-selector=\".item-number\">\n                                       <b>02</b>\n                                    </p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Trasparenza Totale</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Nessuna sorpresa! Con noi, sai esattamente cosa stai pagando e perché. La chiarezza è fondamentale!</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"item features-without-image\">\n                            <div class=\"item-wrapper\">\n                                <div class=\"card-box\">\n                                    <p class=\"item-number mbr-fonts-style\" mbr-if=\"showNumber\" mbr-theme-style=\"display-2\" data-app-selector=\".item-number\">\n                                        <b>03</b>\n                                    </p>\n                                    <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">Innovazione Continua</h4>\n                                    <p class=\"item-text mbr-fonts-style\" mbr-if=\"showCardText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text\">Siamo sempre un passo avanti, utilizzando la tecnologia per offrirti il miglior servizio possibile.</p>\n                                </div>\n                            </div>\n                        </div>\n\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "features04",
          "_sourceTheme": "servicem5",
          "_cid": "uvNUp9Dty3",
          "_anchor": "features-4-uvNUp9Dty3",
          "alias": false,
          "_protectedParams": [],
