              ".image-wrapper": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "img": {
                  "position": "absolute",
                  "top": "0",
                  "left": "0",
                  "width": "100%",
                  "height": "100%",
                  "object-fit": "cover",
                  "opacity": "@imageOpacity",
                  "animation": "none"
                }
              },
              ".item": {
                "@media (max-width: 992px)": {
                  "margin-bottom": "16px",
                  "&:last-child": {
                    "margin-bottom": "0"
                  }
                },
                ".item-wrapper": {
                  "position": "relative",
                  "height": "100%",
                  "border": "3px solid @border",
                  "box-shadow": "4px 4px 0 0 @border",
                  "transition": "all 0.3s ease-in-out",
                  "display": "flex",
                  "flex-direction": "column",
                  "justify-content": "space-between",
                  "overflow": "hidden",
                  "&:hover, &:focus": {
                    "transform": "translate(0.2rem, 0.2rem)",
                    "box-shadow": "none"
                  },
                  ".item-img": {
                    "position": "relative",
                    "img": {
                      "height": "530px",
                      "width": "100%",
                      "object-fit": "cover",
                      "border-radius": "0 !important",
                      "@media (max-width: 1200px)": {
                        "height": "350px"
                      }
                    },
                    "&::before": {
                      "content": "''",
                      "position": "absolute",
                      "top": "0",
                      "left": "0",
                      "width": "100%",
                      "height": "100%",
                      "pointer-events": "none",
                      "opacity": "0.8"
                    }
                  },
                  ".item-content": {
                    "padding": "32px",
                    "@media (max-width: 1440px)": {
                      "padding": "32px 24px"
                    },
                    "@media (max-width: 992px)": {
                      "padding": "32px 16px"
                    },
                    ".item-title_1, .item-title_2, .item-title_3": {
                      "margin-bottom": "48px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "24px"
                      }
                    },
                    ".item-text_1, .item-text_2, .item-text_3": {
                      "margin-bottom": "38px",
                      "@media (max-width: 992px)": {
                        "margin-bottom": "16px"
                      }
                    },
                    ".mbr-section-btn": {
                      ".btn": {
                        "margin-bottom": "0"
                      }
                    }
                  }
                },
                ".card_1": {
                  "background-color": "@card_1",
                  ".item-img::before": {
                    "background-color": "@card_1"
                  }
                },
                ".card_2": {
                  "background-color": "@card_2",
                  ".item-img::before": {
                    "background-color": "@card_2"
                  }
                },
                ".card_3": {
                  "background-color": "@card_3",
                  ".item-img::before": {
                    "background-color": "@card_3"
                  }
                }
              }
            },
            ".item-title_1, .mbr-section-btn": {
              "color": "#000000"
            },
            ".item-text_1": {
              "color": "#000000"
            },
            ".item-title_2, .mbr-section-btn": {
              "color": "#FFFFFF"
            },
            ".item-text_2": {
              "color": "#FFFFFF"
            },
            ".item-title_3, .mbr-section-btn": {
              "color": "#FFFFFF"
            },
            ".item-text_3": {
              "color": "#FFFFFF"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features02 servicem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Image BG\" name=\"showImage\" checked>\n        <input type=\"color\" title=\"Image Border Color\" value=\"#7B2CBF\" name=\"borderImage\" condition=\"showImage\" selected>\n        <input type=\"range\" inline title=\"Image BG Opacity\" name=\"imageOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"showImage\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Card Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"Border Color\" value=\"#000000\" name=\"border\" selected>\n        <input type=\"color\" title=\"Card BG 1\" value=\"#E0AAFF\" name=\"card_1\" selected>\n        <input type=\"color\" title=\"Card BG 2\" value=\"#3C096C\" name=\"card_2\" selected>\n        <input type=\"color\" title=\"Card BG 3\" value=\"#7B2CBF\" name=\"card_3\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                        <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1602604979147-1f4ce329f8db.jpeg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper card_1\">\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1675449937207-27dddf81b40a.jpeg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"item-title_1 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_1, .mbr-section-btn\" mbr-if=\"showCardTitle\">Sicurezza</h4>\n                                <p class=\"item-text_1 mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_1\">La tua tranquillità è la nostra priorità. Siamo qui per te!</p>\n                                <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                    <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Scopri Di Più</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper card_2\">\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1709761942157-2014363b2d09.jpeg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"item-title_2 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_2, .mbr-section-btn\" mbr-if=\"showCardTitle\">Affidabilità</h4>\n                                <p class=\"item-text_2 mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_2\">Pagamenti garantiti in caso di sinistro. Non ti deluderemo!</p>\n                                <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                    <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Scopri Di Più</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"item features-image\">\n                        <div class=\"item-wrapper card_3\">\n                            <div class=\"item-img\">\n                                <img src=\"https://r.mobirisesite.com/962490/assets/images/photo-1676283440965-9a66590e1464.jpeg\" alt=\"Mobirise\">\n                            </div>\n                            <div class=\"item-content\">\n                                <h4 class=\"item-title_3 mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title_3, .mbr-section-btn\" mbr-if=\"showCardTitle\">Semplicità</h4>\n                                <p class=\"item-text_3 mbr-fonts-style\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".item-text_3\">Un processo di sottoscrizione facile e veloce. Zero stress!</p>\n                                <div mbr-buttons=\"\" mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd\">\n                                    <a class=\"btn btn-info\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">Scopri Di Più</a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "features02",
          "_sourceTheme": "servicem5",
          "_cid": "uvNUp9yuMO",
          "_anchor": "features-2-uvNUp9yuMO",
          "alias": false,
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "if(@transparentBg, transparent, @bg-value)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".content-wrapper": {
              "padding": "80px 90px",
              "background-color": "@container",
              "display": "flex",
              "@media (max-width: 1199px)": {
                "display": "block"
              },
              "@media (max-width: 992px)": {
                "padding": "32px 16px"
              },
              ".content-wrap": {
                "width": "45%",
                "padding-right": "48px",
                "@media (max-width: 1199px)": {
                  "margin-bottom": "32px",
                  "width": "100%",
                  "padding-right": "0"
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "24px"
                },
                "& when (@reverseContent)": {
                  "padding-right": "0",
                  "padding-left": "48px",
                  "@media (max-width: 1199px)": {
                    "padding-left": "0"
                  }
                },
                ".text-wrapper": {
                  "@media (max-width: 992px)": {
                    "position": "static",
                    "padding": "0"
                  },
                  ".mbr-section-title": {
                    "position": "relative",
                    "z-index": "1",
                    "margin-bottom": "32px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "24px"
                    }
                  },
                  ".mbr-text": {
                    "position": "relative",
                    "z-index": "1",
                    "margin-bottom": "0"
                  }
                }
              },
              ".panel-group": {
                "width": "55%",
                "@media (max-width: 1199px)": {
                  "width": "100%"
                },
                ".card": {
                  "position": "relative",
                  "padding": "24px",
                  "transition": "all 0.3s ease-in-out",
                  "overflow": "hidden",
                  "margin-top": "16px",
                  "border": "3px solid @border",
                  "box-shadow": "4px 4px 0 0 @border",
                  "background-color": "@card",
                  "@media (max-width: 992px)": {
                    "padding": "16px"
                  },
                  "&:first-child": {
                    "margin-top": "0"
                  },
                  ".card-header": {
                    "background-color": "transparent",
                    "border": "none",
                    "border-radius": "0",
                    "padding": "0",
                    ".panel-title": {
                      "display": "flex",
                      "align-items": "center",
                      "justify-content": "space-between",
                      ".panel-title-edit": {
                        "margin-bottom": "0"
                      },
                      ".icon-wrapper": {
                        "width": "45px",
                        "height": "45px",
                        "min-width": "45px",
                        "display": "inline-flex",
                        "align-items": "center",
                        "justify-content": "center",
                        "margin-left": "8px",
                        "transition": "all 0.3s ease-in-out",
                        ".mbr-iconfont": {
                          "transition": "all 0.3s ease-in-out",
                          "font-size": "26px",
                          "color": "@icon"
                        }
                      },
                      "&:not(.collapsed)": {
                        ".icon-wrapper": {
                          "transform": "rotate(-45deg)"
                        }
                      }
                    }
                  },
                  ".panel-collapse": {
                    ".panel-body": {
                      "position": "relative",
                      "z-index": "1",
                      "margin-top": "20px",
                      "@media (max-width: 992px)": {
                        "margin-top": "16px"
                      },
                      ".panel-text": {
                        "margin-bottom": "0"
                      }
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#050f0f"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".panel-title-edit": {
              "color": "#050f0f"
            },
            ".panel-text": {
              "color": "#000000"
            },
            ".mbr-section-title, .icon-wrapper": {
              "color": "#000000"
            },
            ".panel-title-edit, .icon-wrapper": {
              "color": "#000000"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list01 servicem5\" group=\"List\" plugins=\"mbr-switch-arrow, mobirise-icons2\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Container BG\" value=\"#E0AAFF\" name=\"container\" selected>\n        <header>List</header>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#000000\" name=\"border\" selected>\n        <input type=\"color\" title=\"Card BG\" value=\"#FCF7FF\" name=\"card\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7fff7\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Transparent\" name=\"transparentBg\" condition=\"bg.type === 'color'\" checked>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7fff7\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                    <div class=\"content-wrap\">\n                        <div class=\"text-wrapper\">\n                            <h2 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-2\" data-app-selector=\".mbr-section-title, .icon-wrapper\" mbr-if=\"showTitle\">Domande Frequenti</h2>\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Hai domande? Abbiamo le risposte! Ecco le più comuni.</p>\n                        </div>\n                    </div>\n                    <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                        <div class=\"card\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit, .icon-wrapper\">Come funziona l&#x27;assicurazione vita?</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Protegge i tuoi cari in caso di morte prematura.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit, .icon-wrapper\">Posso personalizzare la mia polizza?</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Assolutamente! Ogni polizza è su misura per te.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit, .icon-wrapper\">Quali sono i vantaggi?</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Protezione, pianificazione e tranquillità per la tua famiglia.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit, .icon-wrapper\">Come richiedo un preventivo?</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Basta cliccare sul pulsante e seguire le istruzioni.</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 4\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit, .icon-wrapper\">Ci sono costi nascosti?</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">No, la trasparenza è la nostra priorità!</p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card\" mbr-if=\"cardAmount > 5\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                                <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core=\"\" href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                    <h4 class=\"panel-title-edit mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-title-edit, .icon-wrapper\">Quando inizia la copertura?</h4>\n                                    <div class=\"icon-wrapper\">\n                                        <span class=\"sign mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                                    </div>\n                                </a>\n                            </div>\n                            <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                                <div class=\"panel-body\">\n                                    <p class=\"panel-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">La copertura inizia subito dopo la sottoscrizione.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_name": "list01",
